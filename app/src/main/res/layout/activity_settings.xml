<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        
        <TextView android:text="Homepage" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/edit_homepage" android:layout_width="match_parent" android:layout_height="wrap_content" />
        
        <TextView android:text="Search engine" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Spinner android:id="@+id/spinner_search" android:layout_width="match_parent" android:layout_height="wrap_content" />
        
        <TextView android:text="User agent (optional)" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/edit_user_agent" android:layout_width="match_parent" android:layout_height="wrap_content" />
        
        <LinearLayout android:layout_marginTop="8dp" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:text="Single-tab mode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <Switch android:id="@+id/switch_single_tab" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        
        <Button android:id="@+id/btn_save" android:layout_marginTop="16dp" android:text="Save" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>